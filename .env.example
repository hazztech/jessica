# ─────────────────────────────────────────────────────────────
#  Browser (public) — safe to expose; Row Level Security protects data.
#  Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
#  Server only (Netlify Functions) — NEVER prefix with VITE_.
#  Set in Netlify → Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_SIGNING_SECRET=        # any long random string
SITE_URL=https://your-site.netlify.app

# Email notifications (optional) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Jessica's <orders@yourdomain.com>"
NOTIFY_EMAIL=jessica@yourdomain.com

# Payments — leave PAYMENTS_ENABLED=false until the shop is ready to take money
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
